#!/usr/bin/python
"""Show the MX Master 2S battery level in the system tray."""

import os
import re
import subprocess
import threading
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import AyatanaAppIndicator3, GLib, Gtk


indicator = AyatanaAppIndicator3.Indicator.new(
    "mx-master-battery", "input-mouse", AyatanaAppIndicator3.IndicatorCategory.HARDWARE
)
indicator.set_status(AyatanaAppIndicator3.IndicatorStatus.ACTIVE)
menu = Gtk.Menu()
title = Gtk.MenuItem(label="MX Master 2S")
title.set_sensitive(False)
menu.append(title)
battery = Gtk.MenuItem(label="Battery: Checking…")
battery.set_sensitive(False)
menu.append(battery)
state = Gtk.MenuItem(label="")
state.set_sensitive(False)
menu.append(state)
menu.show_all()
indicator.set_menu(menu)


def read_battery():
    env = dict(os.environ, LC_ALL="C")
    try:
        output = subprocess.check_output(
            ["solaar", "show", "MX Master 2S"], text=True, env=env,
            stderr=subprocess.DEVNULL, timeout=10,
        )
        match = re.search(r"Battery:\s*(\d+)%\s*,\s*BatteryStatus\.([A-Z_]+)", output)
        if match:
            return match.group(1) + "%", match.group(2).replace("_", " ").capitalize()
    except (OSError, subprocess.SubprocessError):
        pass
    try:
        paths = subprocess.check_output(["upower", "-e"], text=True, env=env, timeout=5).splitlines()
        for path in paths:
            if "/mouse_" not in path:
                continue
            try:
                info = subprocess.check_output(["upower", "-i", path], text=True, env=env, timeout=5)
            except (OSError, subprocess.SubprocessError):
                continue
            fields = {}
            for line in info.splitlines():
                key, sep, value = line.strip().partition(":")
                if sep:
                    fields[key] = value.strip()
            if fields.get("model", "").lower() != "logitech mx master 2s":
                continue
            if fields.get("present") == "no":
                continue
            level = fields.get("battery-level", "unknown")
            percentage = fields.get("percentage", "")
            if percentage:
                level = percentage.split()[0]
            return level.capitalize(), fields.get("state", "unknown").capitalize()
    except (OSError, subprocess.SubprocessError):
        pass
    for device in Path("/sys/class/power_supply").glob("hidpp_battery_*"):
        try:
            model = (device / "model_name").read_text().strip().lower()
            if "mx master 2s" not in model:
                continue
            try:
                level = (device / "capacity").read_text().strip() + "%"
            except OSError:
                try:
                    level = (device / "capacity_level").read_text().strip()
                except OSError:
                    level = "Unknown"
            try:
                status = (device / "status").read_text().strip()
            except OSError:
                status = "Unknown"
            return level.capitalize(), status.capitalize()
        except OSError:
            continue
    return "Unavailable", "Mouse disconnected or battery data unavailable"


refreshing = False


def apply_battery(result):
    global refreshing
    battery.set_label("Battery: " + result[0])
    state.set_label("State: " + result[1])
    refreshing = False
    return False


def update():
    global refreshing
    if not refreshing:
        refreshing = True
        def collect():
            try:
                result = read_battery()
            except Exception:
                result = ("Unavailable", "Battery data unavailable")
            GLib.idle_add(apply_battery, result)
        threading.Thread(target=collect, daemon=True).start()
    return True


if __name__ == "__main__":
    update()
    GLib.timeout_add_seconds(60, update)
    Gtk.main()
